# =============================================================================
# InternMatch AI – Environment Variables Configuration (.env)
# =============================================================================

# 1. Authoritative Database Configuration (Supabase / PostgreSQL)
# For local development with zero external dependencies, SQLite is used by default:
DATABASE_URL=sqlite+aiosqlite:///./internmatch.db

# To connect your live Supabase database, replace with your Supabase Transaction Pooler / Session connection string:
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.xxxx.supabase.co:5432/postgres

# Optional Supabase credentials for client-side storage or auth integration:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. External AI / Large Language Model Integration (Optional)
# InternMatch AI includes a deterministic, grounded rubric engine by default.
# To enable live LLM generation for interview questions and dynamic personalized study plans, set an API key:
LLM_PROVIDER=grounded_rule_based  # Options: grounded_rule_based, openai, gemini
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...

# 3. External Live Job / Internship Board APIs (Optional)
# By default, a rich dataset of curated and synthetic benchmark internships is seeded.
# To stream external live job boards, configure:
RAPIDAPI_KEY=your_rapidapi_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# 4. Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
